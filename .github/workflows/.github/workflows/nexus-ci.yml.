
name: NEXUS - Compilación automática

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Restaurar y compilar NEXUS
    runs-on: windows-latest
    steps:
      - name: Obtener el código
        uses: actions/checkout@v4

      - name: Configurar .NET 8
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x

      - name: Restaurar dependencias
        run: dotnet restore NEXUS.csproj

      - name: Compilar en Release
        run: dotnet build NEXUS.csproj --configuration Release --no-restore

      - name: Guardar compilación
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: nexus-build-${{ github.run_number }}
          path: bin/Release/
          if-no-files-found: warn
          retention-days: 14
